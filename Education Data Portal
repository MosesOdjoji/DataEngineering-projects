from airflow import dag, task
from airflow.operators.python_operator import PythonOperator
from datetime import datetime
import requests
import boto3
import json

default_args = {
    'owner': 'airflow',
    'depends_on_past': False,
    'start_date': datetime(2024, 8, 29),
    'retries': 1,
}

dag = DAG(
    'api_to_s3',
    default_args=default_args,
    description='Call education data urban api and load the result into S3',
    schedule_interval='@daily',
)

def fetch_api_data(**kwargs):
    api_url = 'https://educationdata.urban.org/api/v1/schools/ccd/enrollment/2021/grade-pk/'
    response = requests.get(api_url)
    
    if response.status_code != 200:
        raise ValueError(f"Failed to fetch api data: {response.status_code}")
    return response.json()

def upload_file_to_s3(data, **kwargs):
    s3 = boto3.client('s3')
    data_txt = json.dumps(data)
    s3_bucket_name = 's3://mosesodjoji-raw-landing/ccd_enrollment/'
    file_name = '2021_ccd_enrollment.json'
    s3.put_object(Bucket=s3_bucket_name, Key=file_name, Body=data_txt)

def api_to_s3(**kwargs):
    data = fetch_api_data(**kwargs)
    upload_file_to_s3(data, **kwargs)

fetch_data_task = PythonOperator(
    task_id='fetch_data',
    python_callable=fetch_api_data,
    provide_context=True,
    dag=dag,
)

upload_data_task = PythonOperator(
    task_id='upload_data_task',
    python_callable=upload_file_to_s3,
    provide_context=True,
    dag=dag,
)

# Define the DAG workflow
fetch_data_task >> upload_data_task




