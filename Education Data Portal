--in 2021, which 10 states had the highest number of children enrolled in pre-K
--================================================================================
SELECT
    sum(rslts.enrollment) as total_enrollment,
    rslts.fips as state_code
FROM
  grade_pk_ccd_enrollment,
  UNNEST(grade_pk_ccd_enrollment.results) as t(rslts)
WHERE rslts.year = 2021
AND rslts.grade = -1
AND rslts.enrollment NOT IN (0, -1, -2, -3)
GROUP BY rslts.fips
ORDER BY total_enrollment DESC
LIMIT 10;





